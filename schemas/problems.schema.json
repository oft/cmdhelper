{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "title": "校验模型",
      "description": "供 IDE 解析的 JSON Schema 地址；本地地址相对于当前 JSON 文件。",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "number",
      "const": 1,
      "title": "格式版本",
      "description": "内容格式版本；目录使用整数 1，标准问题模型使用语义版本字符串。"
    },
    "dimensions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "title": "唯一标识",
            "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
            "examples": [
              "scp",
              "upload-file"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "显示名称",
            "description": "字段、条件、实体或维度选项的用户可读名称。"
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "title": "唯一标识",
                  "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
                  "examples": [
                    "scp",
                    "upload-file"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "显示名称",
                  "description": "字段、条件、实体或维度选项的用户可读名称。"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            },
            "title": "维度选项",
            "description": "该维度可选择的离散取值，至少两个且标识不重复。"
          }
        },
        "required": [
          "id",
          "label",
          "options"
        ],
        "additionalProperties": false
      },
      "title": "问题维度",
      "description": "定义对象、空间、目标、时间、连接及质量等问题坐标。"
    },
    "presets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "标题",
            "description": "展示给用户的简短中文名称。"
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "title": "参数或坐标值",
            "description": "以字段或维度标识为键的映射；示例参数必须满足对应场景要求。"
          }
        },
        "required": [
          "title",
          "values"
        ],
        "additionalProperties": false
      },
      "title": "预设问题",
      "description": "提供标题和完整坐标，帮助用户快速选择标准问题。"
    },
    "solutions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "title": "唯一标识",
            "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
            "examples": [
              "scp",
              "upload-file"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "标题",
            "description": "展示给用户的简短中文名称。"
          },
          "tool": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "title": "工具引用",
            "description": "引用 tools/catalog.json 中已定义的工具标识。",
            "examples": [
              "scp",
              "git"
            ]
          },
          "match": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "title": "匹配坐标",
            "description": "维度标识映射到允许值列表，用于筛选候选方案。"
          },
          "requirements": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              }
            },
            "title": "适用要求",
            "description": "维度标识映射到允许值列表；未确认时不能认定方案已经可用。"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "原因",
            "description": "解释推荐该方案或优先检查此节点的理由。"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "执行前",
            "description": "说明执行前的位置、内容或状态；示例可用多行目录树。"
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "执行后",
            "description": "说明成功执行后的预计状态及变化，不代表已实际执行或验证。"
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "title": "执行步骤",
            "description": "按先后顺序列出可操作的步骤。"
          },
          "tradeoffs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "title": "取舍说明",
            "description": "列出投入、限制、副作用及其他需要权衡的因素。"
          },
          "source": {
            "type": "string",
            "format": "uri",
            "title": "信息来源",
            "description": "工具和方案中填写官方 HTTP(S) 文档地址；证据中填写 user 用户确认、inferred 推断或 observed 观察。"
          },
          "assistant": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "title": "命令引用",
                    "description": "引用 commands 目录中定义的命令标识。",
                    "examples": [
                      "scp",
                      "curl"
                    ]
                  },
                  "scenario": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                    "title": "场景引用",
                    "description": "必须属于所引用命令的场景标识。",
                    "examples": [
                      "upload-file",
                      "get"
                    ]
                  }
                },
                "required": [
                  "command",
                  "scenario"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "title": "命令助手入口",
            "description": "引用已有命令和场景；没有可用入口时填写 null。"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "title": "唯一标识",
                  "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
                  "examples": [
                    "scp",
                    "upload-file"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "显示名称",
                  "description": "字段、条件、实体或维度选项的用户可读名称。"
                },
                "verify": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查方法",
                  "description": "说明用户如何确认条件成立；不能声称助手已自动检测。"
                },
                "remedy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "补救措施",
                  "description": "条件不满足时的可操作处理方法。"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查范围",
                  "description": "说明检查的是本机、远端、网络还是其他环境。"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "condition",
                    "platform",
                    "installation"
                  ],
                  "title": "类型",
                  "description": "参数类型：text 文本、boolean 开关、port 端口、positive 正整数；条件类型：condition 环境条件、platform 平台、installation 安装。"
                }
              },
              "required": [
                "id",
                "label",
                "verify",
                "remedy",
                "scope",
                "kind"
              ],
              "additionalProperties": false
            },
            "title": "前置条件",
            "description": "执行工具或方案前必须确认的条件。"
          },
          "acceptance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "title": "唯一标识",
                  "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
                  "examples": [
                    "scp",
                    "upload-file"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "显示名称",
                  "description": "字段、条件、实体或维度选项的用户可读名称。"
                },
                "verify": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查方法",
                  "description": "说明用户如何确认条件成立；不能声称助手已自动检测。"
                },
                "remedy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "补救措施",
                  "description": "条件不满足时的可操作处理方法。"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查范围",
                  "description": "说明检查的是本机、远端、网络还是其他环境。"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "condition",
                    "platform",
                    "installation"
                  ],
                  "title": "类型",
                  "description": "参数类型：text 文本、boolean 开关、port 端口、positive 正整数；条件类型：condition 环境条件、platform 平台、installation 安装。"
                }
              },
              "required": [
                "id",
                "label",
                "verify",
                "remedy",
                "scope",
                "kind"
              ],
              "additionalProperties": false
            },
            "title": "验收要求",
            "description": "说明如何确认目标达成；方案中使用可检查条件，实例和路线中使用结果描述。"
          },
          "checkTree": {
            "title": "分层检查树",
            "description": "根节点为 goal、优先级为 0；先确认目标，再递进检查可行性和环境等条件。",
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "id",
          "title",
          "tool",
          "match",
          "requirements",
          "reason",
          "before",
          "after",
          "steps",
          "tradeoffs",
          "source",
          "assistant",
          "preconditions",
          "acceptance",
          "checkTree"
        ],
        "additionalProperties": false
      },
      "title": "解决方案",
      "description": "包含工具、适用条件、步骤、取舍、检查树及验收要求的方案库。"
    }
  },
  "required": [
    "version",
    "dimensions",
    "presets",
    "solutions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "唯一标识",
          "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
          "examples": [
            "scp",
            "upload-file"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "title": "标题",
          "description": "展示给用户的简短中文名称。"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "优先级",
          "description": "检查树中为非负整数，数值越小越优先；资源中为 unknown 未确认、quick 尽快完成、repeat 重复使用。"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "title": "原因",
          "description": "解释推荐该方案或优先检查此节点的理由。"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": "条件引用",
          "description": "引用工具及方案的条件标识；每个条件在检查树中恰好出现一次。"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "title": "子节点",
          "description": "父节点通过后才继续检查；子节点的优先级数值必须大于父节点。"
        }
      },
      "required": [
        "id",
        "title",
        "priority",
        "reason",
        "checks",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
