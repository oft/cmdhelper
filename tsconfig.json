{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "apps/cli/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
