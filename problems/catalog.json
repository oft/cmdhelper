    {
      "id": "scp",
      "title": "SCP · 单次文件复制",
      "match": {
        "object": [
          "file",
          "directory",
          "video"
        ],
        "space": [
          "remote"
        ],
        "goal": [
          "transfer"
        ],
        "time": [
          "once"
        ]
      },
      "requirements": {
        "connection": [
          "ssh"
        ]
      },
      "reason": "改变文件所在位置，复制后源内容保留；适合已经能 SSH 连接的两台设备。",
      "before": "本机设备 A\n└── 源文件 / 文件夹\n\n远程设备 B\n└── 目标目录",
      "after": "本机设备 A\n└── 源内容保留\n\n远程设备 B\n└── 新增副本（同名内容可能覆盖）",
      "steps": [
        "确认设备 B 的地址、账号与 SSH 端口。",
        "选择文件或文件夹，填写源路径和目标目录。",
        "复制完成后检查退出状态及目标内容。"
      ],
      "tradeoffs": [
        "适合单次复制；反复更新目录时可比较 rsync。",
        "需要目标写入权限，目录复制需要递归。"
      ],
      "source": "https://man.openbsd.org/scp.1",
      "assistant": {
        "command": "scp",
        "scenario": "upload-file"
      },
      "tool": "scp",
      "preconditions": [
        {
          "id": "source-readable",
          "label": "源文件存在且可读取",
          "verify": "在实际源设备检查路径与读取权限；目录还需检查内部内容可读取。",
          "remedy": "更正路径或申请源内容读取权限。",
          "scope": "源设备",
          "kind": "condition"
        },
        {
          "id": "target-writable",
          "label": "目标目录存在、可写且空间足够",
          "verify": "在目标设备确认目录、写入权限和可用空间。",
          "remedy": "创建目标目录、申请权限或释放空间后重新检查。",
          "scope": "目标设备",
          "kind": "condition"
        },
        {
          "id": "overwrite-policy",
          "label": "已确认同名文件与覆盖策略",
          "verify": "检查目标同名文件，确认可覆盖，或先备份 / 改用新目录。",
          "remedy": "先备份或选择新目标目录，再确认传输。",
          "scope": "目标设备",
          "kind": "condition"
        }
      ],
      "acceptance": [
        {
          "id": "transfer-complete",
          "label": "传输进程成功结束",
          "verify": "检查退出码和错误输出，不只看进度达到 100%。",
          "remedy": "根据错误恢复连接、权限或空间；重新传输后再检查。",
          "scope": "执行结果",
          "kind": "condition"
        },
        {
          "id": "content-verified",
          "label": "目标内容及原有数据符合预期",
          "verify": "核对目录层级、文件清单与大小；需要内容完整性保证时比对校验和，并检查覆盖与保留结果。",
          "remedy": "定位缺失或异常文件后重新传输；覆盖问题从备份恢复。",
          "scope": "执行结果",
          "kind": "condition"
        }
      ],
      "checkTree": {
        "id": "goal",
        "title": "所选方案是否符合目标与约束？",
        "priority": 0,
        "reason": "先确认做什么、在哪做，以及是否符合方案的适用条件。",
        "checks": [],
        "children": [
          {
            "id": "feasibility",
            "title": "这条路线在环境中是否可行？",
            "priority": 1,
            "reason": "先判断平台与连接等硬条件；路线不可行时，先调整方案。",
            "checks": [
              "scp-supported",
              "ssh-supported",
              "ssh-reachable",
              "ssh-service"
            ],
            "children": [
              {
                "id": "environment",
                "title": "执行能力是否就绪？",
                "priority": 2,
                "reason": "路线可行后，再确认安装、认证及服务能力。",
                "checks": [
                  "scp-installed",
                  "ssh-installed",
                  "authentication",
                  "sftp-service"
                ],
                "children": [
                  {
                    "id": "resources",
                    "title": "本次输入与操作细节是否就绪？",
                    "priority": 3,
                    "reason": "上层通过后，才检查具体文件、端口、编码与覆盖策略。",
                    "checks": [
                      "source-readable",
                      "target-writable",
                      "overwrite-policy"
                    ],
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      }
    },
