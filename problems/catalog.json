    {
      "id": "remux",
      "title": "FFmpeg · 更换视频封装",
      "match": {
        "object": [
          "video"
        ],
        "space": [
          "local"
        ],
        "goal": [
          "convert"
        ],
        "time": [
          "once",
          "repeat"
        ]
      },
      "requirements": {
        "quality": [
          "container"
        ]
      },
      "reason": "只改变容器时，可以尝试流复制；无需解码和重新编码，前提是目标容器兼容原有媒体流。",
      "before": "本机\n└── input.mkv\n    └── 原有视频 / 音频编码",
      "after": "本机\n├── input.mkv（保留）\n└── output.mp4\n    └── 兼容的原有编码流",
      "steps": [
        "先确认原文件包含哪些视频、音频和字幕流。",
        "检查目标容器是否支持需要保留的流。",
        "使用流复制并验证输出文件与轨道。"
      ],
      "tradeoffs": [
        "更换扩展名本身不等于转换封装。",
        "流复制不降低码率、不改变分辨率；不兼容的流可能需要转码。",
        "反复处理还需要额外的批处理或任务调度。"
      ],
      "source": "https://ffmpeg.org/ffmpeg.html#Streamcopy",
      "assistant": null,
      "tool": "ffmpeg",
      "preconditions": [
        {
          "id": "container-compatible",
          "label": "目标容器兼容需要保留的媒体流",
          "verify": "检查视频、音频、字幕编码是否被目标容器支持；先用样本验证。",
          "remedy": "改用兼容容器，或转码不兼容的媒体流。",
          "scope": "本机",
          "kind": "condition"
        }
      ],
      "acceptance": [
