    {
      "id": "ssh",
      "title": "SSH · 远程终端",
      "match": {
        "object": [
          "device"
        ],
        "space": [
          "remote"
        ],
        "goal": [
          "operate"
        ],
        "time": [
          "once",
          "repeat"
        ]
      },
      "requirements": {
        "connection": [
          "ssh"
        ]
      },
      "reason": "设备位置不变，改变的是操作入口：在本地建立到远程设备的命令会话。",
      "before": "本机终端\n\n远程设备\n└── 待操作的命令环境",
      "after": "本机终端 → SSH 加密连接\n                 └── 远程命令环境",
      "steps": [
        "确认主机地址、账号与认证方式。",
        "核对服务器身份后登录。",
        "在远程执行操作，结束时用 exit 返回本机。"
      ],
