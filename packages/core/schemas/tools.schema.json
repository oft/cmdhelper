{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "title": "校验模型",
      "description": "供 IDE 解析的 JSON Schema 地址；本地地址相对于当前 JSON 文件。",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "number",
      "const": 1,
      "title": "格式版本",
      "description": "内容格式版本；目录使用整数 1，标准问题模型使用语义版本字符串。"
    },
    "tools": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "title": "唯一标识",
            "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
            "examples": [
              "scp",
              "upload-file"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "标题",
            "description": "展示给用户的简短中文名称。"
          },
          "source": {
            "type": "string",
            "format": "uri",
            "title": "信息来源",
            "description": "工具和方案中填写官方 HTTP(S) 文档地址；证据中填写 user 用户确认、inferred 推断或 observed 观察。"
          },
          "preconditions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                  "title": "唯一标识",
                  "description": "以英文字母开头，仅含字母、数字、下划线和连字符；在所属集合中唯一。",
                  "examples": [
                    "scp",
                    "upload-file"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "显示名称",
                  "description": "字段、条件、实体或维度选项的用户可读名称。"
                },
                "verify": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查方法",
                  "description": "说明用户如何确认条件成立；不能声称助手已自动检测。"
                },
                "remedy": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "补救措施",
                  "description": "条件不满足时的可操作处理方法。"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "检查范围",
                  "description": "说明检查的是本机、远端、网络还是其他环境。"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "condition",
                    "platform",
                    "installation"
                  ],
                  "title": "类型",
                  "description": "参数类型：text 文本、boolean 开关、port 端口、positive 正整数；条件类型：condition 环境条件、platform 平台、installation 安装。"
                }
              },
              "required": [
                "id",
                "label",
                "verify",
                "remedy",
                "scope",
                "kind"
              ],
              "additionalProperties": false
            },
            "title": "前置条件",
            "description": "执行工具或方案前必须确认的条件。"
          }
        },
        "required": [
          "id",
          "title",
          "source",
          "preconditions"
        ],
        "additionalProperties": false
      },
      "title": "工具库",
      "description": "工具及其官方来源、前置条件和检查方法。"
    }
  },
  "required": [
    "version",
    "tools"
  ],
  "additionalProperties": false
}
