{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "cmdhelper-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "node scripts/prepare-packages.mjs && pnpm --filter @cmdhelper/web dev",
    "build": "pnpm typecheck && node scripts/prepare-packages.mjs && pnpm --filter @cmdhelper/web build",
    "test": "pnpm typecheck && node scripts/prepare-packages.mjs && tsx --test scripts/test/*.test.ts && node --test packages/core/test/*.test.js",
    "cli": "node scripts/prepare-packages.mjs && node apps/cli/bin/cmdhelper.js",
    "prepare:packages": "node scripts/prepare-packages.mjs",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "check:data": "tsx scripts/check-data.ts",
    "typecheck": "tsc --noEmit",
    "build:schemas": "pnpm --filter @cmdhelper/schema build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
