{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "cmdhelper-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm prepare:packages && pnpm --filter @cmdhelper/web dev",
    "build": "pnpm typecheck && pnpm --filter @cmdhelper/web build",
    "test": "pnpm typecheck && tsx --test scripts/test/*.test.ts packages/core/test/*.test.ts apps/web/test/*.test.ts",
    "cli": "pnpm prepare:packages && node apps/cli/dist/cmdhelper.js",
    "prepare:packages": "pnpm build:schemas && tsx scripts/prepare-packages.ts && pnpm --filter @cmdhelper/core build && pnpm --filter cmdhelper build",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "check:data": "tsx scripts/check-data.ts",
    "typecheck": "pnpm prepare:packages && tsc --noEmit && pnpm --filter @cmdhelper/web typecheck",
    "build:schemas": "pnpm --filter @cmdhelper/schema build",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,html}\" \"packages/*/src/**/*.ts\" \"packages/core/test/**/*.ts\" \"scripts/**/*.ts\" articles/index.ts",
    "format:check": "prettier --check \"apps/**/*.{ts,vue,css,html}\" \"packages/*/src/**/*.ts\" \"packages/core/test/**/*.ts\" \"scripts/**/*.ts\" articles/index.ts",
    "articles:generate": "tsx scripts/generate-articles.ts"
  },
  "devDependencies": {
    "@cmdhelper/schema": "workspace:*",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
